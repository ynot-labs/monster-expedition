{
  "name": "monster-expedition",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:widget": "vite build && node scripts/inline-widget.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run clean && npm run build:widget && npm run build:server",
    "build:native": "swift build -c release --package-path native",
    "package:app": "bash scripts/package-app.sh",
    "package:dmg": "bash scripts/create-dmg.sh",
    "notarize": "bash scripts/notarize.sh",
    "typecheck": "tsc -p tsconfig.widget.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test tests/codex-link.test.ts tests/game-core.test.ts",
    "test:integration": "tsx --test tests/mcp-server.integration.test.ts",
    "test:native": "bash native/scripts/test.sh",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "check:web": "npm run typecheck && npm run test && npm run build && npm run test:integration && npm run validate:plugin",
    "check": "npm run check:web && npm run test:native",
    "dev:widget": "vite",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "pixi.js": "^8.19.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.5.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.1"
  }
}
